{
  "name": "geld-pinguin-reels",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automatische Reel-Produktion und -Veroeffentlichung fuer @geld.pinguin",
  "scripts": {
    "reel": "node src/index.js",
    "dry": "node src/index.js --dry-run",
    "render-only": "node src/index.js --no-publish",
    "insights": "node scripts/insights.js",
    "analyse": "node scripts/analyse.js",
    "bericht": "node scripts/insights.js && node scripts/analyse.js",
    "faellig": "node scripts/faellig.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "engines": {
    "node": ">=20"
  }
}
